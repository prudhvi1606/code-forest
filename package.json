{
  "name": "code-forest",
  "displayName": "Code Forest",
  "description": "A calm VS Code extension that visualizes coding sessions as a growing forest.",
  "version": "0.0.1",
  "publisher": "prudh16sai11",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],

  "activationEvents": [
    "onView:codeForest.sidebar",
    "onCommand:codeForest.openForest"
  ],

  "main": "./out/extension.js",

  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeForest",
          "title": "Code Forest",
          "icon": "media/forest.svg"
        }
      ]
    },

    "views": {
      "codeForest": [
        {
          "id": "codeForest.sidebar",
          "name": "Code Forest",
          "type": "webview"
        }
      ]
    },

    "commands": [
      {
        "command": "codeForest.openForest",
        "title": "Code Forest: Open Forest"
      }
    ]
  },

  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublish": "npm run compile"
  },

  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/code-forest"
  },

  "keywords": [
    "forest",
    "productivity",
    "visualization",
    "focus",
    "ambient",
    "calm"
  ]
}
